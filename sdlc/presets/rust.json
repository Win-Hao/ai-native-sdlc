{
  "_preset": "rust",
  "_detect": [
    "Cargo.toml"
  ],
  "artifact_dir": "sdlc",
  "gates": {
    "test_lock": {
      "enabled": true,
      "test_globs": [
        "tests/**",
        "**/tests/**",
        "benches/**"
      ]
    },
    "protected_paths": {
      "enabled": true,
      "paths": [
        "**/target/**",
        "**/generated/**",
        "Cargo.lock",
        ".github/workflows/**"
      ]
    },
    "production_gate": {
      "enabled": true,
      "match": [
        "deploy*prod",
        "prod*deploy",
        "kubectl*production",
        "terraform apply",
        "helm upgrade",
        "fly deploy",
        "shuttle deploy"
      ],
      "approval_env": "SDLC_RELEASE_APPROVAL"
    },
    "irreversible": {
      "enabled": true,
      "match": [
        "git push --force",
        "git push -f",
        "git reset --hard",
        "git clean -fdx",
        "rm -rf /",
        "DROP TABLE",
        "TRUNCATE",
        "cargo publish"
      ]
    },
    "plan_sync": {
      "enabled": true,
      "exempt": [
        "CLAUDE.md",
        "REVIEW.md",
        "evals/**",
        ".claude/**"
      ]
    }
  },
  "format_command": "rustfmt",
  "pipeline": [
    {
      "id": "intent",
      "artifact": "intent.md",
      "done_when": "accepted",
      "command": "/sdlc:intent",
      "draft_hint": "Review it — set status: accepted to open the next stage, or reject it."
    },
    {
      "id": "spec",
      "artifact": "spec.md",
      "done_when": "accepted",
      "command": "/sdlc:spec",
      "draft_hint": "Resolve its flagged concerns with their policy owners, then set status: accepted."
    },
    {
      "id": "plan",
      "artifact": "plan.md",
      "done_when": "approved",
      "command": "/sdlc:plan",
      "draft_hint": "Interrogate the plan, then set status: approved."
    },
    {
      "id": "build",
      "artifact": "plan.md",
      "done_when": "implemented",
      "command": "/sdlc:build",
      "draft_hint": null
    },
    {
      "id": "verify",
      "artifact": null,
      "command": "/sdlc:verify"
    },
    {
      "id": "review",
      "artifact": null,
      "command": "/sdlc:review"
    }
  ],
  "drive": "off"
}
