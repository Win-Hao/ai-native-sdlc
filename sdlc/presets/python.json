{
  "_preset": "python",
  "_detect": [
    "pyproject.toml",
    "setup.py",
    "requirements.txt"
  ],
  "artifact_dir": "sdlc",
  "gates": {
    "test_lock": {
      "enabled": true,
      "test_globs": [
        "**/test_*.py",
        "**/*_test.py",
        "**/conftest.py",
        "tests/**",
        "**/tests/**"
      ]
    },
    "protected_paths": {
      "enabled": true,
      "paths": [
        "**/migrations/**",
        "**/alembic/versions/**",
        "**/*_pb2.py",
        "**/*_pb2_grpc.py",
        "**/generated/**",
        "**/.venv/**",
        "poetry.lock",
        "uv.lock",
        ".github/workflows/**"
      ]
    },
    "production_gate": {
      "enabled": true,
      "match": [
        "deploy*prod",
        "prod*deploy",
        "kubectl*production",
        "terraform apply",
        "helm upgrade",
        "fly deploy",
        "modal deploy"
      ],
      "approval_env": "SDLC_RELEASE_APPROVAL"
    },
    "irreversible": {
      "enabled": true,
      "match": [
        "git push --force",
        "git push -f",
        "git reset --hard",
        "git clean -fdx",
        "rm -rf /",
        "DROP TABLE",
        "TRUNCATE",
        "alembic downgrade",
        "manage.py flush",
        "twine upload"
      ]
    },
    "plan_sync": {
      "enabled": true,
      "exempt": [
        "CLAUDE.md",
        "REVIEW.md",
        "evals/**",
        ".claude/**"
      ]
    }
  },
  "format_command": "ruff format",
  "pipeline": [
    {
      "id": "intent",
      "artifact": "intent.md",
      "done_when": "accepted",
      "command": "/sdlc:intent",
      "draft_hint": "Review it — set status: accepted to open the next stage, or reject it."
    },
    {
      "id": "spec",
      "artifact": "spec.md",
      "done_when": "accepted",
      "command": "/sdlc:spec",
      "draft_hint": "Resolve its flagged concerns with their policy owners, then set status: accepted."
    },
    {
      "id": "plan",
      "artifact": "plan.md",
      "done_when": "approved",
      "command": "/sdlc:plan",
      "draft_hint": "Interrogate the plan, then set status: approved."
    },
    {
      "id": "build",
      "artifact": "plan.md",
      "done_when": "implemented",
      "command": "/sdlc:build",
      "draft_hint": null
    },
    {
      "id": "verify",
      "artifact": null,
      "command": "/sdlc:verify"
    },
    {
      "id": "review",
      "artifact": "findings.md",
      "done_when": "reviewed",
      "command": "/sdlc:review",
      "draft_hint": null
    }
  ],
  "drive": "off"
}
