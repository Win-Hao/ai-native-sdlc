{
  "_preset": "node",
  "_detect": [
    "package.json"
  ],
  "artifact_dir": "sdlc",
  "gates": {
    "test_lock": {
      "enabled": true,
      "test_globs": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/*.spec.ts",
        "**/*.spec.js",
        "**/__tests__/**",
        "**/e2e/**",
        "tests/**",
        "test/**"
      ]
    },
    "protected_paths": {
      "enabled": true,
      "paths": [
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**",
        "**/.next/**",
        "**/*.generated.ts",
        "**/generated/**",
        "package-lock.json",
        "pnpm-lock.yaml",
        "yarn.lock",
        ".github/workflows/**"
      ]
    },
    "production_gate": {
      "enabled": true,
      "match": [
        "vercel --prod",
        "wrangler deploy",
        "npm run deploy",
        "pnpm deploy",
        "netlify deploy --prod",
        "sst deploy --stage production",
        "serverless deploy --stage prod"
      ],
      "approval_env": "SDLC_RELEASE_APPROVAL"
    },
    "irreversible": {
      "enabled": true,
      "match": [
        "git push --force",
        "git push -f",
        "git reset --hard",
        "git clean -fdx",
        "rm -rf /",
        "DROP TABLE",
        "TRUNCATE",
        "prisma migrate reset",
        "npm publish"
      ]
    },
    "plan_sync": {
      "enabled": true,
      "exempt": [
        "CLAUDE.md",
        "REVIEW.md",
        "evals/**",
        ".claude/**"
      ]
    }
  },
  "format_command": "node_modules/.bin/prettier --write",
  "pipeline": [
    {
      "id": "intent",
      "artifact": "intent.md",
      "done_when": "accepted",
      "command": "/sdlc:intent",
      "draft_hint": "Review it — set status: accepted to open the next stage, or reject it."
    },
    {
      "id": "spec",
      "artifact": "spec.md",
      "done_when": "accepted",
      "command": "/sdlc:spec",
      "draft_hint": "Resolve its flagged concerns with their policy owners, then set status: accepted."
    },
    {
      "id": "plan",
      "artifact": "plan.md",
      "done_when": "approved",
      "command": "/sdlc:plan",
      "draft_hint": "Interrogate the plan, then set status: approved."
    },
    {
      "id": "build",
      "artifact": "plan.md",
      "done_when": "implemented",
      "command": "/sdlc:build",
      "draft_hint": null
    },
    {
      "id": "verify",
      "artifact": null,
      "command": "/sdlc:verify"
    },
    {
      "id": "review",
      "artifact": "findings.md",
      "done_when": "reviewed",
      "command": "/sdlc:review",
      "draft_hint": null
    }
  ],
  "drive": "off"
}
