{
  "_preset": "generic",
  "_detect": [],
  "artifact_dir": "sdlc",
  "drive": "off",
  "gates": {
    "test_lock": { "enabled": true, "test_globs": ["**/test_*", "**/*_test.*", "**/*.test.*", "**/*.spec.*", "**/tests/**", "**/__tests__/**"] },
    "protected_paths": { "enabled": true, "paths": ["**/generated/**", "**/vendor/**", "**/migrations/**", ".github/workflows/**"] },
    "production_gate": { "enabled": true, "match": ["deploy*prod", "prod*deploy", "kubectl*production", "terraform apply", "helm upgrade"], "approval_env": "SDLC_RELEASE_APPROVAL" },
    "irreversible": { "enabled": true, "match": ["git push --force", "git push -f", "git reset --hard", "git clean -fdx", "rm -rf /", "DROP TABLE", "DROP DATABASE", "TRUNCATE"] },
    "plan_sync": { "enabled": true, "exempt": ["CLAUDE.md", "REVIEW.md", "evals/**", ".claude/**"] }
  },
  "format_command": null
}
